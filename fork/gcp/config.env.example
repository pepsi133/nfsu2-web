# Settings for the fork/gcp scripts. Copy this file to config.env and fill it in.
# config.env is in .gitignore. It holds no secret: secrets live in Secret Manager only.

# Google Cloud
PROJECT_ID="my-nfsu2-project"          # the ID of your GCP project, not its name
REGION="europe-central2"
ZONE="europe-central2-a"
VM_NAME="nfsu2"
BUILD_VM_NAME="nfsu2-build"
MACHINE_TYPE="e2-medium"
BUCKET="${PROJECT_ID}-nfsu2"           # without gs://
AR_REPO="nfsu2"

# The game
NFSU2_HOST="game.example.com"          # the public hostname of the Cloudflare Tunnel
IDLE_MINUTES="30"                      # the VM powers off after this many minutes without players

# Cloudflare (IDs only, never a token). Find them in the Zero Trust dashboard.
CF_ACCOUNT_ID=""                       # 32 hex characters
CF_ACCESS_APP_ID=""                    # the self-hosted Access application (UUID)
CF_ACCESS_POLICY_ID=""                 # its Allow policy (UUID)
CF_GOOGLE_IDP_ID=""                    # the Google login method (UUID)
